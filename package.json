{
  "name": "caldas-auth",
  "version": "1.0.0",
  "description": "Centralized auth server for CaldasStudios apps (Better Auth, OAuth 2.1 / OIDC provider)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/local.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/local.ts",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-admin.ts",
    "client:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "build": "tsc --noEmit",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-integration.ts"
  },
  "type": "module",
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.24",
    "@better-auth/passkey": "^1.7.24",
    "@hono/node-server": "^2.1.8",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.24",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "auth": "^1.7.24"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
