# Public URL of this auth server (issuer = BETTER_AUTH_URL + /api/auth)
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
DATABASE_URL=postgres://auth:auth@127.0.0.1:5433/auth
# Vercel: use Neon's pooled URL (hostname contains -pooler), keeping TLS enabled.
# Example: postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Neon deploy fills this with the direct URL; migrations prefer it over DATABASE_URL.
DATABASE_URL_UNPOOLED=
PORT=3000
# Comma-separated origins allowed to call the auth API from a browser
TRUSTED_ORIGINS=
# Comma-separated client IDs of first-party apps (created with --trusted)
TRUSTED_CLIENT_IDS=
# Google sign-in (optional). Redirect URI: BETTER_AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to true to allow only admin-created accounts
DISABLE_SIGNUP=false
# Used by `npm run client:create`
ADMIN_EMAIL=
ADMIN_PASSWORD=
